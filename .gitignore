__pycache__/
*.py[cod]
.gitconfig

# SLURM job output
logs/

# Symlinks into scratch created by scripts/bootstrap.sh -- the real data and
# checkpoints live on /scratch and must never be committed.
/runs
/data

# Checkpoints / datasets, in case anything lands here directly
*.sif
*.pt
*.safetensors
*.bin
*.npy
*.tar.gz

# torchtitan's default dump_folder. Every configs/titan/*.toml redirects this to
# scratch, but a run launched from the repo root without an override lands here,
# and one Qwen3 0.6B checkpoint shard is several GB.
/outputs
wandb/
.wandb/
